# Локальная разработка ПРОТИВ НАСТОЯЩЕГО БОТА.
# В бою ничего этого не нужно: адрес API прилетает параметром ?api= от самого
# бота (он подставляет текущий адрес cloudflared-тоннеля), а авторизация
# приходит подписью Telegram.

# Адрес API бота — то, что записал тоннель (см. autotrade_bot/deploy).
# VITE_API_BASE=https://xxx-yyy.trycloudflare.com

# ⚠️ Отладочный ключ, равный WEBAPI_DEV_TOKEN в .env бота. Нужен затем, что в
# обычном браузере Telegram initData взять негде. Никогда не коммитить.
# VITE_DEV_TOKEN=
