# ─────────────────────────────────────────────────────────────
# SOLANA SWING BOT · V1 (DEMO) — окружение
# Скопировать в .env рядом с package.json. .env НИКОГДА не коммитится.
# Значения ключей перезаписываются из интерфейса (раздел «Профиль»),
# поэтому внутри значений не держите ручных комментариев.
# ─────────────────────────────────────────────────────────────

# Режим данных: mock — синтетика без ключей и сети, live — реальные API
DATA_MODE=mock

# HTTP-сервер демо-контура (слушает только 127.0.0.1)
API_HOST=127.0.0.1
API_PORT=8788

# База и рабочие файлы
DB_PATH=./data/demo.db

# ── Ключи внешних сервисов ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HELIUS_API_KEY=
GEMINI_API_KEY=

# Секрет кошелька (private key / seed-фраза). Хранится зашифрованным,
# ключ шифрования — data/.secret_key (создаётся автоматически).
WALLET_SECRET=

# ── Стартовые значения демо-контура (дальше меняются в «Профиле») ──
DEMO_START_BALANCE=500
DEMO_MONTHLY_DEPOSIT=500
