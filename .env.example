# ─────────────────────────────────────────────────────────────
# SOLANA SWING BOT · V1 (DEMO) — окружение
# Скопировать в .env рядом с package.json. .env НИКОГДА не коммитится.
# Значения ключей перезаписываются из интерфейса (раздел «Профиль»),
# поэтому внутри значений не держите ручных комментариев.
# ─────────────────────────────────────────────────────────────

# Режим данных: mock — синтетика без ключей и сети, live — реальные рыночные API
# В live работают: DexScreener (пулы, цена, ликвидность, возраст), GeckoTerminal
# (свечи OHLCV), RugCheck (права минта, сожжённая ликвидность), FluxRPC (концентрация
# топ-10 держателей). Gemini нужен только для описания монеты и новостного фильтра —
# без него сигналы строятся на слоях 1–4, а проверка видна как «нет ключа».
DATA_MODE=mock

# HTTP-сервер демо-контура (слушает только 127.0.0.1).
# Порт 8790, а НЕ 8788: на сервере владельца 8788 занят живым автотрейдом
# (futures webapi). При совпадении портов демо-контур не поднимется молча —
# на curl ответит чужой сервис, и это выглядит как успешный запуск.
API_HOST=127.0.0.1
API_PORT=8790

# База и рабочие файлы
DB_PATH=./data/demo.db

# Ключ доступа к API. Пусто — открыто (так удобно локально). Задан — все
# /api/* требуют заголовок X-Api-Token, а приложение просит ключ один раз и
# запоминает его. Защита живёт здесь, а не в Caddy: установленный на рабочий
# стол PWA не умеет отвечать на парольный запрос браузера и ломается, а здесь
# защищены только данные и действия — оболочка, манифест и иконки открыты.
# Сгенерировать: openssl rand -hex 24
API_TOKEN=

# ── Ключи внешних сервисов ──
# Solana RPC для чтения состояния цепочки (концентрация держателей, права минта).
# Ключ едет в адресе, поэтому он маскируется в текстах ошибок (config.redactUrl).
FLUX_RPC_URL=https://eu.fluxrpc.com?key=ВАШ_КЛЮЧ
# WebSocket-адрес того же провайдера (для будущей потоковой подписки).
FLUX_WS_URL=wss://ws.eu.fluxrpc.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gemini нужен только для описания монеты и разбора тональности найденных
# публикаций (бесплатный ключ Google AI Studio). Без него тональность считается
# по лексикону, а проверка видна как «нет ключа» и сигнал не блокирует.
GEMINI_API_KEY=

# ── Медиаслой: упоминания в соцсетях (Apify) ──
# Готовые сборщики Apify берут на себя аккаунты и прокси — своих аккаунтов X
# держать не нужно. Тратится кредит аккаунта Apify: актор tweet-scraper стоит
# около $0.40 за 1000 публикаций, поэтому запросы идут только по монетам,
# которые уже прошли фильтры, и не чаще MEDIA_TTL_MIN.
APIFY_TOKEN=
APIFY_TWEET_ACTOR=apidojo~tweet-scraper
APIFY_MAX_ITEMS=50
APIFY_TIMEOUT_SEC=180
# Сколько публикаций в сутки разрешено собирать суммарно (защита кредита).
APIFY_DAILY_ITEMS=1000
# Как долго считаются свежими уже собранные упоминания, минуты.
MEDIA_TTL_MIN=30

# Секрет кошелька (private key / seed-фраза). Хранится зашифрованным,
# ключ шифрования — data/.secret_key (создаётся автоматически).
WALLET_SECRET=

# ── Стартовые значения демо-контура (дальше меняются в «Профиле») ──
DEMO_START_BALANCE=500
DEMO_MONTHLY_DEPOSIT=500
